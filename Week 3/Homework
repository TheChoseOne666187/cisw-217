 CREATE TABLE books (
    id SERIAL PRIMARY KEY,
    title VARCHAR(100),
    author VARCHAR(100),
    genre VARCHAR(50),
    year_published INT
);

INSERT INTO books (title, author, genre, year_published)
VALUES
