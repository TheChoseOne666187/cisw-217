CREATE TABLE Students(
  id INTEGER PRIMARY KEY ,   
  name TEXT,
  email TEXT,
  city TEXT,                             
  date_enrolled TEXT                     
);

CREATE TABLE Courses(
  id INTEGER PRIMARY KEY,
  student_id INT,                       
  title TEXT,                             
  tuition NUMERIC(10,2),                  
  FOREIGN KEY(student_id) REFERENCES Students(id) 
);

