Part A – Create Tables
CREATE TABLE Animal_Types (
    id INTEGER PRIMARY KEY,
    species TEXT,
    habitat TEXT,
    diet TEXT
);

CREATE TABLE Animals (
    id INTEGER PRIMARY KEY,
    name TEXT,
    species_id INTEGER,
    age INTEGER
);

